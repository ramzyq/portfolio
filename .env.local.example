# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it's ignored by git.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# The inbox that contact form messages are delivered to
TO_EMAIL=you@example.com

# Optional: the verified sender address Resend will send from.
# Defaults to Resend's shared onboarding sender if omitted.
# FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: public site URL used for OpenGraph / canonical metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
